# ========================================================
# AUTO YOUTUBE CLIPPER - ENVIRONMENT CONFIGURATION
# ========================================================
# Dapatkan Gemini API Key gratis di https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Model Whisper lokal (Pilihan: tiny, base, small, medium, large-v3)
# 'base' disarankan untuk kecepatan & akurasi yang seimbang
WHISPER_MODEL_SIZE=base

# Device Whisper: 'cuda' (disarankan jika ada GPU NVIDIA) atau 'cpu'
WHISPER_DEVICE=cuda

# Model Gemini yang digunakan (gemini-3.8-flash adalah rilis terbaru resmi Google AI Studio)
GEMINI_MODEL=gemini-3.8-flash
